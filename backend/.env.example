# Copier ce fichier en .env (jamais commité) puis mettre sa propre clé.
RODIUMAI_API_KEY=rd_sk_YOUR_KEY

# Modèle sélectionné par défaut dans l'interface (doit faire partie de RODIUMAI_MODELS).
RODIUMAI_MODEL=anthropic/claude-sonnet-4-5-20250929

# Modèles autorisés, séparés par des virgules, au format id=Libellé. Tout autre modèle est refusé (400).
RODIUMAI_MODELS=anthropic/claude-sonnet-4-5-20250929=Claude Sonnet 4.5,anthropic/claude-haiku-4-5-20251001=Claude Haiku 4.5,openai/gpt-4o-mini=GPT-4o mini,mistral/mistral-large-3=Mistral Large 3

# RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
# RODIUMAI_MAX_TOKENS=1024
# DATABASE_URL=sqlite:///chat.db
